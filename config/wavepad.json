{
  "manufacturer": "Custom",
  "keyboard_name": "wavepad",
  "maintainer": "you",
  "bootloader": "rp2040",
  "processor": "RP2040",

  "usb": {
    "vid": "0xFEED",
    "pid": "0x0001",
    "device_version": "1.0.0"
  },

  "features": {
    "bootmagic": true,
    "extrakey": true,
    "nkro": true,
    "encoder": true
  },

  "matrix_pins": {
    "rows": ["GP2", "GP3", "GP4", "GP5"],
    "cols": ["GP6", "GP7", "GP8", "GP9"]
  },

  "diode_direction": "COL2ROW",

  "layouts": {
    "LAYOUT_ortho_4x4": {
      "layout": [
        { "label":"Enc", "row":4, "col":0, "x":4, "y":0, "encoder":[0,0] },

        { "matrix":[0,0], "row":0, "col":0, "x":0, "y":0 },
        { "matrix":[0,1], "row":0, "col":1, "x":1, "y":0 },
        { "matrix":[0,2], "row":0, "col":2, "x":2, "y":0 },
        { "matrix":[0,3], "row":0, "col":3, "x":3, "y":0 },

        { "matrix":[1,0], "row":1, "col":0, "x":0, "y":1 },
        { "matrix":[1,1], "row":1, "col":1, "x":1, "y":1 },
        { "matrix":[1,2], "row":1, "col":2, "x":2, "y":1 },
        { "matrix":[1,3], "row":1, "col":3, "x":3, "y":1 },

        { "matrix":[2,0], "row":2, "col":0, "x":0, "y":2 },
        { "matrix":[2,1], "row":2, "col":1, "x":1, "y":2 },
        { "matrix":[2,2], "row":2, "col":2, "x":2, "y":2 },
        { "matrix":[2,3], "row":2, "col":3, "x":3, "y":2 },

        { "matrix":[3,0], "row":3, "col":0, "x":0, "y":3 },
        { "matrix":[3,1], "row":3, "col":1, "x":1, "y":3 },
        { "matrix":[3,2], "row":3, "col":2, "x":2, "y":3 },
        { "matrix":[3,3], "row":3, "col":3, "x":3, "y":3 }
      ]
    }
  },

  "encoder": {
    "rotary": [
      {
        "pin_a": "GP10",
        "pin_b": "GP11",
        "resolution": 4
      }
    ]
  }
}