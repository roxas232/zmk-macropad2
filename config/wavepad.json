{
  "manufacturer": "Custom",
  "keyboard_name": "wavepad",
  "maintainer": "you",
  "bootloader": "rp2040",
  "processor": "RP2040",
  "url": "",
  "usb": {
    "vid": "0xFEED",
    "pid": "0x0001",
